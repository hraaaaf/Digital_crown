{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cephalo-vnext-lot04-candidate-benchmark-manifest-v1",
  "title": "Cephalo vNext LOT04 Generic Candidate Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "environment",
    "preprocessing",
    "dataset",
    "metrics",
    "acceptance_policy",
    "contamination"
  ],
  "properties": {
    "schema_version": {
      "const": "CEPHALO_LOT04_CANDIDATE_BENCHMARK_MANIFEST_V1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "artifact_name",
        "artifact_sha256",
        "artifact_size_bytes",
        "source_repository",
        "source_commit",
        "source_license",
        "weight_license_status",
        "framework",
        "provider",
        "output_count",
        "index_mapping_version",
        "source_model_file_sha256",
        "source_inference_file_sha256"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_name": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_license": {
          "type": "string",
          "minLength": 1
        },
        "weight_license_status": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "output_count": {
          "const": 38
        },
        "index_mapping_version": {
          "type": "string",
          "minLength": 1
        },
        "source_model_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_inference_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "input_size",
        "resize_impl",
        "preserve_range",
        "channel_order",
        "normalization",
        "decoder"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_frozen_before_scoring",
        "cases",
        "development_case_ids",
        "acceptance_case_ids",
        "source_manifest_sha256",
        "qc_sha256",
        "calibration_sha256",
        "landmark_agreement_sha256",
        "measurement_agreement_sha256",
        "split_policy"
      ],
      "properties": {
        "manifest_frozen_before_scoring": {
          "const": true
        },
        "cases": {
          "type": "array",
          "minItems": 1
        },
        "development_case_ids": {
          "type": "array",
          "uniqueItems": true
        },
        "acceptance_case_ids": {
          "type": "array",
          "uniqueItems": true
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "qc_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calibration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "landmark_agreement_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurement_agreement_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "split_policy": {
          "const": "train+valid=development;test=acceptance"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "acceptance_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "policy_id",
        "policy_sha256",
        "landmark_tolerances",
        "clinical_tolerances",
        "device_stratified_policy"
      ]
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aariz_reference_found_in_frozen_source",
        "training_dataset_declared",
        "external_patient_overlap_proven_absent",
        "note"
      ],
      "properties": {
        "aariz_reference_found_in_frozen_source": {
          "type": "boolean"
        },
        "training_dataset_declared": {
          "type": "string"
        },
        "external_patient_overlap_proven_absent": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
