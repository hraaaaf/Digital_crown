# Backend URL sans slash final
VITE_API_URL=https://app.votre-domaine.ma

# Active HTTPS Vite si certs/cert.pem et certs/key.pem existent
VITE_ENABLE_HTTPS=true

# Monitoring frontend (Patient Companion est volontairement exclu de Sentry Replay en D1)
VITE_SENTRY_DSN=

# Patient Companion — Firebase Web Auth dédié aux patients.
# Ces identifiants de configuration Web ne remplacent jamais les credentials Admin backend.
VITE_PATIENT_FIREBASE_API_KEY=
VITE_PATIENT_FIREBASE_AUTH_DOMAIN=
VITE_PATIENT_FIREBASE_PROJECT_ID=
VITE_PATIENT_FIREBASE_APP_ID=
