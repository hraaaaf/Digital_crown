# Backend cabinet URL sans slash final
VITE_API_URL=https://app.votre-domaine.ma

# Tour de contrôle mobile : le cabinet redirige vers cette origine dédiée.
# Sur le build servi par le control-plane, cette URL doit être l'origine courante.
VITE_PLATFORM_APP_URL=https://control.votre-domaine.ma

# API Superadmin/licences du control-plane. Pour préserver WebAuthn + le cookie
# HttpOnly SameSite=Strict, le frontend de la Tour et cette API doivent partager
# exactement la même origine HTTPS en production.
VITE_PLATFORM_API_URL=https://control.votre-domaine.ma

# Active HTTPS Vite si certs/cert.pem et certs/key.pem existent
VITE_ENABLE_HTTPS=true

# Monitoring frontend
VITE_SENTRY_DSN=
