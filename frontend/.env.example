# Backend cabinet URL sans slash final
VITE_API_URL=https://app.votre-domaine.ma

# Control-plane Superadmin/licences. Pour une Tour de contrôle mobile distante,
# utiliser l'URL HTTPS dédiée du control-plane. Si absent, le frontend retombe
# sur VITE_API_URL, ce qui reste adapté aux déploiements frontend/API cohébergés.
VITE_PLATFORM_API_URL=https://control.votre-domaine.ma

# Active HTTPS Vite si certs/cert.pem et certs/key.pem existent
VITE_ENABLE_HTTPS=true

# Monitoring frontend
VITE_SENTRY_DSN=
