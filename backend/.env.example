# Sécurité — générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# Base de données
DATABASE_URL=postgresql://user:password@localhost/digitalcrown_db

# IA
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
OLLAMA_URL=http://localhost:11434

# CORS (séparés par virgule)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optionnel
DEBUG=false
ENVIRONMENT=production
