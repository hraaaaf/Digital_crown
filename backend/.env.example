# Securite - generer avec:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# Base de donnees
DATABASE_URL=postgresql://user:password@localhost/digitalcrown_db

# Production
DEBUG=false
ENVIRONMENT=production
ALLOWED_ORIGINS=https://app.votre-domaine.ma,https://www.votre-domaine.ma
FRONTEND_URL=https://app.votre-domaine.ma
APP_PUBLIC_URL=https://app.votre-domaine.ma
SUPPORT_EMAIL=support@votre-domaine.ma
SUPERADMIN_EMAIL=admin@votre-domaine.ma

# IA
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
OLLAMA_URL=http://localhost:11434

# Emails transactionnels SMTP
SMTP_HOST=smtp.votre-fournisseur.com
SMTP_PORT=587
SMTP_USERNAME=apikey-ou-utilisateur
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@votre-domaine.ma
SMTP_FROM_NAME=Digital Crown
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=admin@votre-domaine.ma

# Monitoring
SENTRY_DSN=

# HTTPS self-hosted
# Start_PROD.bat et Vite utilisent automatiquement ces fichiers s'ils existent :
# certs/cert.pem
# certs/key.pem
